              ]
            },
            "description": "Campos presentes, mas vazios, também devem ser recusados.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"\",\n  \"email\": \"\",\n  \"password\": \"\",\n  \"administrador\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json()",
                  "",
                  "pm.test('Status 400', () => pm.response.to.have.status(400))",
                  "pm.test('Recusa nome em branco', () => pm.expect(body.nome).to.eql('nome não pode ficar em branco'))",
                  "pm.test('Recusa email em branco', () => pm.expect(body.email).to.eql('email não pode ficar em branco'))",
                  "pm.test('Recusa password em branco', () => pm.expect(body.password).to.eql('password não pode ficar em branco'))",
                  "pm.test('Recusa administrador em branco', () => pm.expect(body.administrador).to.eql(\"administrador deve ser 'true' ou 'false'\"))"
                ]
              }
            }
          ]
        },
        {
          "name": "Não cadastrar usuário com tipos de dados inválidos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Os 4 campos são do tipo string: número e booleano devem ser recusados, inclusive administrador true (booleano) no lugar de \"true\" (string).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": 123,\n  \"email\": 123,\n  \"password\": 123,\n  \"administrador\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json()",
                  "",
                  "pm.test('Status 400', () => pm.response.to.have.status(400))",
                  "pm.test('Recusa nome numérico', () => pm.expect(body.nome).to.eql('nome deve ser uma string'))",
                  "pm.test('Recusa email numérico', () => pm.expect(body.email).to.eql('email deve ser uma string'))",
                  "pm.test('Recusa password numérico', () => pm.expect(body.password).to.eql('password deve ser uma string'))",
                  "pm.test('Recusa administrador booleano', () => pm.expect(body.administrador).to.eql(\"administrador deve ser 'true' ou 'false'\"))"
                ]
              }
            }
          ]
        },

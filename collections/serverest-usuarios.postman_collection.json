{
  "info": {
    "_postman_id": "7318d346-bd93-472e-87ee-bb56a4d8dce6",
    "name": "ServeRest - Usuários",
    "description": "Testes automatizados do CRUD de usuários da API ServeRest, com autenticação JWT. Execute a coleção inteira, na ordem: cada pasta prepara os dados usados pela seguinte e a pasta Limpeza remove tudo o que foi criado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Verificações aplicadas a todas as requisições da coleção",
          "if (pm.response.code === 429) {",
          "  pm.test('Limite de requisições da API respeitado', () => {",
          "    throw new Error('HTTP 429: a API recusou a requisição por excesso de chamadas. Aguarde um minuto e execute novamente.')",
          "  })",
          "}",
          "",
          "pm.test('Tempo de resposta abaixo de 3 segundos', () => pm.expect(pm.response.responseTime).to.be.below(3000))",
          "pm.test('Resposta em JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'))"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "POST /usuarios",
      "description": "Cadastro de usuários: sucesso e validações de campos e regras de negócio.",
      "item": [
        {
          "name": "Cadastrar usuário administrador com dados válidos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Cria o usuário administrador usado no restante da coleção. Nome, e-mail e senha são únicos a cada execução.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{userName}}\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"administrador\": \"true\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const sufixo = `${Date.now()}${Math.floor(Math.random() * 1000)}`",
                  "pm.collectionVariables.set('userName', `QA Admin ${sufixo}`)",
                  "pm.collectionVariables.set('userEmail', `qa.admin.${sufixo}@example.com`)",
                  "pm.collectionVariables.set('userPassword', `Senha@${sufixo}`)"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json()",
                  "",
                  "pm.test('Status 201', () => pm.response.to.have.status(201))",
                  "pm.test('Mensagem de cadastro realizado', () => pm.expect(body.message).to.eql('Cadastro realizado com sucesso'))",
                  "pm.test('Retorna _id com 16 caracteres alfanuméricos', () => pm.expect(body._id).to.match(/^[A-Za-z0-9]{16}$/))",
                  "",
                  "pm.collectionVariables.set('userId', body._id)"
                ]
              }
            }
          ]
        },
        {

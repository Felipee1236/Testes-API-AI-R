    {
      "name": "GET /usuarios",
      "description": "Listagem de usuários: contrato, os 5 filtros documentados e validação dos parâmetros de consulta.",
      "item": [
        {
          "name": "Listar todos os usuários",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Valida o contrato da listagem, a consistência entre quantidade e itens e a presença dos usuários cadastrados nesta execução."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json()",
                  "const schemaUsuario = JSON.parse(pm.collectionVariables.get('schemaUsuario'))",
                  "",
                  "pm.test('Status 200', () => pm.response.to.have.status(200))",
                  "pm.test('Segue o contrato da listagem', () => {",
                  "  pm.response.to.have.jsonSchema({",
                  "    type: 'object',",
                  "    additionalProperties: false,",
                  "    required: ['quantidade', 'usuarios'],",
                  "    properties: {",
                  "      quantidade: { type: 'integer', minimum: 0 },",
                  "      usuarios: { type: 'array', items: schemaUsuario },",
                  "    },",
                  "  })",
                  "})",
                  "pm.test('Quantidade corresponde ao total de itens', () => pm.expect(body.quantidade).to.eql(body.usuarios.length))",
                  "pm.test('Inclui os usuários cadastrados nesta execução', () => {",
                  "  const ids = body.usuarios.map(usuario => usuario._id)",
                  "  pm.expect(ids).to.include.members([pm.collectionVariables.get('userId'), pm.collectionVariables.get('user2Id')])",
                  "})"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar usuários por e-mail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios?email={{userEmail}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "{{userEmail}}"
                }
              ]
            },
            "description": "O filtro por e-mail deve retornar exatamente o usuário cadastrado nesta execução."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json()",
                  "",
                  "pm.test('Status 200', () => pm.response.to.have.status(200))",
                  "pm.test('Retorna exatamente 1 usuário', () => pm.expect(body.quantidade).to.eql(1))",
                  "pm.test('Retorna o usuário cadastrado', () => pm.expect(body.usuarios[0]._id).to.eql(pm.collectionVariables.get('userId')))"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar usuários por parte do nome, sem diferenciar maiúsculas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios?nome={{nomeParcial}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ],
              "query": [
                {
                  "key": "nome",
                  "value": "{{nomeParcial}}"
                }
              ]
            },
            "description": "O filtro por nome faz busca parcial e ignora maiúsculas e minúsculas."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Parte do nome, em minúsculas: \"QA Admin 123\" vira \"admin 123\"",
                  "pm.variables.set('nomeParcial', pm.collectionVariables.get('userName').replace('QA ', '').toLowerCase())"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json()",
                  "",
                  "pm.test('Status 200', () => pm.response.to.have.status(200))",
                  "pm.test('Retorna exatamente 1 usuário', () => pm.expect(body.quantidade).to.eql(1))",
                  "pm.test('Retorna o usuário cadastrado', () => pm.expect(body.usuarios[0]._id).to.eql(pm.collectionVariables.get('userId')))"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrar usuários não administradores",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/usuarios?administrador=false",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ],
              "query": [
                {
                  "key": "administrador",
                  "value": "false"
                }
              ]
            },
            "description": "O filtro administrador=false deve retornar apenas usuários comuns."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json()",
                  "const ids = body.usuarios.map(usuario => usuario._id)",
                  "",
                  "pm.test('Status 200', () => pm.response.to.have.status(200))",
                  "pm.test('Todos os usuários retornados são não administradores', () => {",
                  "  pm.expect(body.usuarios.every(usuario => usuario.administrador === 'false')).to.be.true",
                  "})",
                  "pm.test('Inclui o usuário comum desta execução', () => pm.expect(ids).to.include(pm.collectionVariables.get('user2Id')))",
                  "pm.test('Não inclui o administrador desta execução', () => pm.expect(ids).to.not.include(pm.collectionVariables.get('userId')))"
                ]
              }
            }
          ]
        },
        {
          "name": "Combinar todos os filtros disponíveis",
          "request": {
            "method": "GET",
            "header": [],
            "url": {

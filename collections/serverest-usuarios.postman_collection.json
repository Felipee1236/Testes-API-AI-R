              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "O campo administrador é string e só aceita 'true' ou 'false'.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"QA Admin Invalido\",\n  \"email\": \"{{emailUnico}}\",\n  \"password\": \"Senha@123\",\n  \"administrador\": \"sim\"\n}",
              "options": {
                "raw": {
                  "language": "json"

        {
          "name": "Não cadastrar usuário sem os campos obrigatórios",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "description": "Envia corpo vazio e valida a mensagem de cada um dos 4 campos obrigatórios.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json()",
                  "",
                  "pm.test('Status 400', () => pm.response.to.have.status(400))",
                  "pm.test('Informa que nome é obrigatório', () => pm.expect(body.nome).to.eql('nome é obrigatório'))",
                  "pm.test('Informa que email é obrigatório', () => pm.expect(body.email).to.eql('email é obrigatório'))",
                  "pm.test('Informa que password é obrigatório', () => pm.expect(body.password).to.eql('password é obrigatório'))",
                  "pm.test('Informa que administrador é obrigatório', () => pm.expect(body.administrador).to.eql('administrador é obrigatório'))"
                ]
              }
            }
          ]
        },
        {
